# Copy this file to ".env" and fill in your own values. Never share .env.
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=   # optional, AliExpress uses "default" if empty
BLOG_ID=2976840353661435945

# Quality filter
MIN_POSITIVE_RATE=90
MIN_ORDERS=10
MAX_PRICE_USD=50

# Pinterest (optional) - developers.pinterest.com
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Or paste a token from the app page instead of the app secret:
PINTEREST_ACCESS_TOKEN=
# Trial access only works on the sandbox: https://api-sandbox.pinterest.com
PINTEREST_API=https://api.pinterest.com

# Minutes between Pinterest pins
PIN_INTERVAL_MIN=90

# Bulk import post queue
POST_INTERVAL_MIN=20
DAILY_POST_LIMIT=25
